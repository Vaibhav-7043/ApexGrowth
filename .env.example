# Razorpay AI Buildathon 2026 - Configuration Template
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/revenue_agent.db

# LLM Provider Configuration (Optional for offline demo mode)
LLM_PROVIDER=gemini # options: gemini, openai, fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Razorpay Test Mode Credentials (Optional: Sandbox simulator active if blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Policy Defaults
MAX_DISCOUNT_PERCENT=20.0
MAX_CAMPAIGN_AUDIENCE=500
MAX_BUDGET_INR=50000.0
COOLDOWN_DAYS_PER_CUSTOMER=14
